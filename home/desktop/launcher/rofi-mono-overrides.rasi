/* adi1090x/rofi · type-5 / style-4 — mono renk katmanı + HiDPI uyarlaması
 *
 * rofi-themes/type-5/style-4.rasi üst kaynaktan bit-bit aynı duruyor (geometri
 * oranları, widget ağacı, modi listesi); renge ve ölçüye dair HER sapma bu
 * dosyada. Builder (rofi-themes.nix) bunu o dosyanın SONUNA ekler — rasi'de son
 * kural kazanır, sıra ters çevrilirse üst kaynağın turuncu/yeşil/kırmızısı geri
 * gelir (waybar-mono-overrides.css ile birebir aynı kural).
 *
 * Yer tutucular (çift-at ile sarılı palet adları) build-time'da waybar-mono.css
 * okunarak literal hex'e çevrilir — üretilen dosyada hiç kalmamalıdır. Neden rasi'nin
 * kendi @değişken'i değil: rofi 2.0 linear-gradient İÇİNDE @değişken'i
 * ayrıştıramıyor ve o tek satır yüzünden tema dosyasının tamamını sessizce
 * reddediyor (ayrıntı: rofi-themes.nix ve CLAUDE.md).
 *
 * Renk eşlemesi — üst kaynak zaten neredeyse monokromdu, yalnız üç vurgu rengi
 * (turuncu/yeşil/kırmızı) paletin gri basamaklarına indirildi:
 *
 *   #22272C  pencere, hata kutusu         → background  (en dip katman)
 *   #2E343B  sekme çubuğu, gradient sağ   → surface     (yükseltilmiş yüzey)
 *   #4C4F52  gradient sol                 → overlay     (seçim şeridi tepesi)
 *   white    arama hapı zemini            → bright
 *   white    girdi metni                  → foreground
 *   black    arama hapı ikonu             → background
 *   gray     seçili olmayan satır         → color3
 *   #FF9030  seçili satır / aktif sekme   → bright
 *   #19B466  çalışan uygulama             → color6
 *   #EA5553  seçili + çalışan             → bright
 */

/* --- Yazı tipi --- */
/* Üst kaynak "Iosevka Nerd Font 10" ister; rice'ın geri kalanı (waybar, eski
 * rofi teması) JetBrainsMono Nerd Font kullanıyor — tek yüz kalsın diye. */
* {
    font:                        "JetBrainsMono Nerd Font 12";
}

/* --- HiDPI uyarlaması: BOE NE160QDM, 2560x1600 @ scale 1 (~189 dpi) ---
 * Üst kaynak ~96 dpi varsayıyor; 800px pencere + 10pt yazı bu panelde okunmaz
 * kalıyor. Oranlar korundu: inputbar ve mode-switcher'ın yan boşluğu pencerenin
 * %25'i kalsın diye 200px → 275px büyüdü. Tek satırlık geri alma noktaları. */
window {
    width:                       1100px;
    background-color:            @@background@@;
}
element-icon {
    size:                        28px;
}

/* --- Arama satırı --- */
inputbar {
    margin:                      0px 275px;
    border-color:                @@overlay@@;
}
textbox-prompt-colon {
    background-color:            @@bright@@;
    text-color:                  @@background@@;
}
entry {
    text-color:                  @@foreground@@;
    placeholder-color:           @@muted@@;
}

/* --- Liste öğeleri ---
 * Üst kaynak dokuz durumdan yalnız üçünü boyuyor (normal.active,
 * selected.normal, selected.active); kalan altısı genel `element` kuralına
 * düşüyor. rofi 2.0'da bu bugün SORUN DEĞİL — ölçüldü: `@theme` dahili Solarized
 * temayı birleştirmiyor, tamamen değiştiriyor, dolayısıyla boyanmamış durum
 * beyaz satır üretmiyor. Yine de dokuzu da açıkça yazıldı: rofi birleştirme
 * davranışına dönerse tema sessizce okunmaz hale gelirdi. */
element {
    text-color:                  @@color3@@;
    border-color:                @@surface@@;
}
element normal.normal {
    background-color:            transparent;
    text-color:                  @@color3@@;
}
element alternate.normal {
    background-color:            transparent;
    text-color:                  @@color3@@;
}
element normal.urgent {
    background-color:            transparent;
    text-color:                  @@bright@@;
}
element alternate.urgent {
    background-color:            transparent;
    text-color:                  @@bright@@;
}
element normal.active {
    background-image:            linear-gradient(to right, @@overlay@@, @@surface@@);
    text-color:                  @@color6@@;
}
element alternate.active {
    background-image:            linear-gradient(to right, @@overlay@@, @@surface@@);
    text-color:                  @@color6@@;
}
element selected.normal {
    background-image:            linear-gradient(to right, @@overlay@@, @@surface@@);
    text-color:                  @@bright@@;
}
element selected.urgent {
    background-image:            linear-gradient(to right, @@overlay@@, @@surface@@);
    text-color:                  @@bright@@;
}
element selected.active {
    background-image:            linear-gradient(to right, @@overlay@@, @@surface@@);
    text-color:                  @@bright@@;
}

/* --- Sekmeler (drun · run · dosya gezgini · pencere) --- */
mode-switcher {
    margin:                      0px 275px;
    background-color:            @@surface@@;
}
button {
    text-color:                  @@muted@@;
}
button selected {
    text-color:                  @@bright@@;
}

/* --- Mesaj / hata --- */
message {
    text-color:                  @@bright@@;
}
error-message {
    background-color:            @@background@@;
    text-color:                  @@foreground@@;
}
