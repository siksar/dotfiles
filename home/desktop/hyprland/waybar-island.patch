 void Group::hide_group() {
   box.unset_state_flags(Gtk::StateFlags::STATE_FLAG_PRELIGHT);
-  revealer.set_reveal_child(false);
+  if (two_axis) {
+    hovered = false;
+    retarget();
+  } else {
+    revealer.set_reveal_child(false);
+  }
+}
+
+// Hedef: başlatıcı kipi > fare üstünde (panel) > kapalı. Animasyon sürerken
+// hedef değişirse yay o anki konum ve HIZDAN devam eder — hızlı gir-çık'ta ada
+// yön değiştirirken kesilip baştan başlamaz.
+void Group::retarget() {
+  int min_w = 0;
+  int nat_w = 0;
+  int min_h = 0;
+  int nat_h = 0;
+  revealer_box.get_preferred_width(min_w, nat_w);
+  revealer_box.get_preferred_height_for_width(nat_w, min_h, nat_h);
+
+  // Kapalı adanın genişliği = öndeki satırın doğal genişliği.
+  int lead_w = 0;
+  int lead_h = 0;
+  if (leader != nullptr) {
+    int lead_min = 0;
+    leader->get_preferred_width(lead_min, lead_w);
+    leader->get_preferred_height_for_width(lead_w, lead_min, lead_h);
+  }
+  const double rest_w = lead_w;
+
+  bool opening = false;
+  if (!morph_mode.empty() && morph_sizes[morph_mode].isArray()) {
+    const auto& m = morph_sizes[morph_mode];
+    to_w = m[0].asDouble();
+    to_h = std::max(0.0, m[1].asDouble() - lead_h);
+    to_o = 0;  // panel içeriği gizli; başlatıcı kendi içeriğini çizer
+    opening = true;
+  } else if (hovered) {
+    to_w = std::max<double>(nat_w, rest_w);
+    to_h = nat_h;
+    to_o = 1;
+    opening = true;
+  } else {
+    to_w = rest_w;
+    to_h = 0;
+    to_o = 0;
+  }
+  if (cur_h < 0.5 && cur_w < 0.5) {
+    cur_w = rest_w;  // kapalıyken kap kapalı adanın genişliğinden başlar
+  }
+  start_h = cur_h;
+  const double w = 2 * M_PI / (opening ? open_response : close_response);
+  k = w * w;
+  c = 2 * (opening ? open_damping : close_damping) * w;
+  if (tick_id == 0) {
+    last_time = -1;
+    tick_id = clip.add_tick_callback(sigc::mem_fun(*this, &Group::onTick));
+  }
+}
+
+// Genişlik HEP çift piksel: pencere sabit genişlikte (çift) ve ada ortalı;
+// tek/çift arasında gidip gelen genişlik ortalamayı yarım piksel kaydırıyor,
+// saat ve alan numaraları her karede 1 px sağa sola titriyordu (120 fps
+// kayıtla ölçüldü, 7 Eki 2026).
+void Group::applySize() {
+  const int w = 2 * static_cast<int>(std::ceil(std::max(0.0, cur_w) / 2.0));
+  const int h = static_cast<int>(std::lround(std::max(0.0, cur_h)));
+  clip.set_size_request(w, h);
+  revealer_box.set_opacity(cur_o);
+}
+
+bool Group::onTick(const Glib::RefPtr<Gdk::FrameClock>& clock) {
+  const gint64 now = clock->get_frame_time();
+  double dt = last_time < 0 ? 1.0 / 120 : (now - last_time) / 1e6;
+  last_time = now;
+  dt = std::min(dt, 0.05);  // takılan kareden sonra sıçrama yok
+
+  // Yarı örtük Euler, 1 ms adımlarla: sert yayda da kararlı.
+  for (double left = dt; left > 1e-9; left -= 0.001) {
+    const double h = std::min(0.001, left);
+    vel_w += (-k * (cur_w - to_w) - c * vel_w) * h;
+    vel_h += (-k * (cur_h - to_h) - c * vel_h) * h;
+    cur_w += vel_w * h;
+    cur_h += vel_h * h;
+  }
+
+  // Saydamlık zamana değil adanın O ANKİ boyutuna bağlı: içerik ada büyürken
+  // kırpılarak açılır, küçülürken birlikte toplanır, ada boş bir blok gibi
+  // görünmez. Başlatıcı açıkken (morph) panel içeriği hızla söner ve fare
+  // yeniden gelene kadar gizli kalır — başlatıcı kapanırken panel belirmesin.
+  int pmin = 0;
+  int pnat_w = 0;
+  int pnat_h = 0;
+  revealer_box.get_preferred_width(pmin, pnat_w);
+  revealer_box.get_preferred_height_for_width(pnat_w, pmin, pnat_h);
+  if (!morph_mode.empty() || suppress_panel) {
+    cur_o = std::max(0.0, cur_o - dt / 0.10);
+  } else {
+    const double frac = pnat_h > 1 ? cur_h / pnat_h : 0.0;
+    const double t = std::clamp((frac - 0.06) / 0.40, 0.0, 1.0);
+    cur_o = t * t * (3 - 2 * t);  // smoothstep
+  }
+  const double want_o = (!morph_mode.empty() || suppress_panel) ? 0.0 : (to_h > 0 ? 1.0 : 0.0);
+
+  const bool settled = std::abs(cur_w - to_w) < 0.3 && std::abs(cur_h - to_h) < 0.3 &&
+                       std::abs(vel_w) < 3 && std::abs(vel_h) < 3 &&
+                       std::abs(cur_o - want_o) < 0.01;
+  if (settled) {
+    cur_w = to_w;
+    cur_h = to_h;
+    cur_o = want_o;
+    vel_w = vel_h = 0;
+  }
+  applySize();
+  if (settled) {
+    tick_id = 0;
+    return false;
+  }
+  return true;
+}
+
+// custom/morph etiketi: başlatıcı açıkken metni kip adıdır ("apps"…), kapalıyken
+// boşluk. Sınıfa değil METNE bakılır: CSS'te karşılığı olmayan sınıf değişimi
+// GTK3'te style-updated yaymıyor.
+void Group::findMorphLabel(Gtk::Widget& w) {
+  if (morph_label != nullptr || !morph_sizes.isObject()) return;
+  auto* label = dynamic_cast<Gtk::Label*>(&w);
+  if (label != nullptr && w.get_name() == "custom-morph") {
+    morph_label = label;
+    label->property_label().signal_changed().connect(sigc::mem_fun(*this, &Group::onMorphStyle));
+    onMorphStyle();
+    return;
+  }
+  if (auto* container = dynamic_cast<Gtk::Container*>(&w)) {
+    for (auto* child : container->get_children()) {
+      findMorphLabel(*child);
+    }
+  }
+}
+
+void Group::onMorphStyle() {
+  std::string mode = morph_label->get_text();
+  mode.erase(0, mode.find_first_not_of(" \t\n"));
+  mode.erase(mode.find_last_not_of(" \t\n") + 1);
+  if (!morph_sizes.isMember(mode)) mode.clear();
+  if (mode != morph_mode) {
+    morph_mode = mode;
+    if (!mode.empty()) suppress_panel = true;
+    retarget();
+  }
+}
+
+// Fare olayları yalnız adanın kendi dikdörtgeninde; pencerenin saydam kalanı
+// alttaki pencerelere geçer (wl_surface giriş bölgesi).
+void Group::updateInputShape() {
+  auto* top = event_box_.get_toplevel();
+  if (top == nullptr || !top->get_realized()) return;
+  int x = 0;
+  int y = 0;
+  if (!event_box_.translate_coordinates(*top, 0, 0, x, y)) return;
+  const Cairo::RectangleInt rect{x, y, event_box_.get_allocated_width(),
+                                 event_box_.get_allocated_height()};
+  top->get_window()->input_shape_combine_region(Cairo::Region::create(rect), 0, 0);
 }
 
