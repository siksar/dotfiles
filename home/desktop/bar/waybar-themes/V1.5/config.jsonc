{
    "layer": "top",
    "position": "top",
    "margin-top": 5,
    "width": 1340,
    "modules-left": [ "clock", "group/main", "tray", "hyprland/workspaces", "mpris"],
    "modules-center": [ ],
    "modules-right": [ "custom/update", "network", "pulseaudio", "backlight", "battery", "custom/power" ],

"battery": {
        "bat": "BAT1",
        "interval": 30,
        "format": "{capacity}% {icon}",
        "format-icons": ["󰁺", "󰁽", "󰁿", "󰂁", "󰁹"],
        "states": { "warning": 20, "critical": 10 }
    },

"backlight": {
    "device": "amdgpu_bl1",
    "format": "{icon}",
    "format-icons": ["󰃞", "󰃟", "󰃠"],
    "on-scroll-up": "brightnessctl -e4 -n2 set 5%+",
    "on-scroll-down": "brightnessctl -e4 -n2 set 5%-",
    "tooltip-format": "Parlaklık : {percent}%"
},

"clock": {
    "format": " {:%I:%M %p}", // AM PM format
    //"format": "  {:%H:%M}",// 24H
    "format-alt": "{:%A  |  %H:%M  |  %e %B}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
 },

   "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-bluetooth": "{icon} {volume}%",
    "format-muted": "󰝟",
    "format-icons": {
        "alsa_output.pci-0000_00_1f.3.analog-stereo": "",
        "alsa_output.pci-0000_00_1f.3.analog-stereo-muted": "",
        "headphone": "",
        "hands-free": "",
        "headset": "",
        "phone": "",
        "phone-muted": "",
        "portable": "",
        "car": "",
        "default": ["", ""]
    },
"scroll-step": 1,
"on-click": "pavucontrol"

 "network": {
	     "format": "{ifname}",
	     "format-wifi": "{icon} {ifname}",
	     "format-ethernet": "󱚻 {ifname}",
	     "format-disconnected": "󰌙",
	     "tooltip-format": "{ipaddr}  {bandwidthUpBits}  {bandwidthDownBits}",
	     "format-linked": "󰈁 {ifname} (No IP)",
	     "tooltip-format-wifi": "{essid} {icon} {signalStrength}%",
	     "tooltip-format-ethernet": "{ifname} 󱚻",
	     "tooltip-format-disconnected": "󰌙 Disconnected",
	     "max-length": 30,
	     "format-icons": [
	     	"󰤯", "󰤟", "󰤢", "󰤥", "󰤨"
	     ],
	     "on-click": "omarchy-launch-wifi"
},

"hyprland/workspaces": {
	"format": "{icon}",
  	"format-icons": {
		"1": "A",
		"2": "B",
		"3": "C",
		"4": "D",
		"5": "E",
		"6": "F",
		"7": "G",
		"8": "H",
		"9": "I",
		"10": "J"
	},
  "on-scroll-up": "hyprctl dispatch workspace e+1",
	"on-scroll-down": "hyprctl dispatch workspace e-1",
       "persistent-workspaces": {
             "*": 5
       }
},

"tray": {
"icon-size": 12,
"spacing": 6,
"icons": {
    "blueman": "bluetooth",
    "TelegramDesktop": "$HOME/.local/share/icons/hicolor/16x16/apps/telegram.png"
}
},

"mpris": {
	"interval": 10,
	"format": "{player_icon} {dynamic}",
	"format-paused": "{status_icon} {artist} {title}",
	"on-click-middle": "playerctl play-pause",
	"on-click": "playerctl previous",
	"on-click-right": "playerctl next",
	"scroll-step": 5.0,
	"on-scroll-up": "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+",
	"on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
	"smooth-scrolling-threshold": 1,
	"tooltip": true,
	"tooltip-format": "{status_icon} {dynamic}\nLeft Click: previous\nMid Click: Pause\nRight Click: Next",
	"player-icons": {
		"chromium": "",
		"default": "",
		"firefox": "",
		"kdeconnect": "",
		"mopidy": "",
		"mpv": "󰐹",
		"spotify": "",
		"vlc": "󰕼",
	},
	"status-icons": {
		"paused": "󰐎",
		"playing": "",
		"stopped": "",
	},
	"dynamic-order": ["artist", "title"],
	"ignored-players": ["firefox", "zen"],
	"max-length": 50
},

"custom/omarchy": {
"format": "⏻",
"on-click": "omarchy-menu",
"on-click-right": "ghostty",
"tooltip-format": "Omarchy Menu\n\nSuper + Alt + Space"
},

"custom/update": {
"format": "⏻",
"exec": "omarchy-update-available",
"on-click": "omarchy-launch-floating-terminal-with-presentation omarchy-update",
"tooltip-format": "Omarchy update available",
"signal": 7,
"interval": 21600
},

"custom/power": {
	"format": "⏻",
	"on-click": "omarchy-menu power",
	"tooltip": true,
	"tooltip-format":"Güç menüsü"
},

"group/main": {
	"orientation": "inherit",
	"modules": [
		"custom/omarchy",
		"custom/separator#blank"
	]
},

"custom/separator#blank": {
	"format": " ",
	"interval": "once",
	"tooltip": false
}
}
