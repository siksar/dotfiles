# matugen şablonu → çıktı: ~/.config/cava/config (ELLE DÜZENLENMEZ)
# Renk reload: pkill -USR2 -x cava (matugen post_hook — cava'yı yeniden
# başlatmadan yalnız renkleri tazeler).
#
# İdle bütçesi notu: cava sürekli ses örnekleyen bir görselleştirici —
# otomatik BAŞLATILMAZ, istendiğinde terminalden `cava` ile açılır.

[general]
framerate = 60
autosens = 1

[input]
method = pipewire
source = auto

[color]
gradient = 1
gradient_count = 6
gradient_color_1 = '#{{colors.primary.default.hex_stripped}}'
gradient_color_2 = '#{{colors.secondary.default.hex_stripped}}'
gradient_color_3 = '#{{colors.tertiary.default.hex_stripped}}'
gradient_color_4 = '#{{colors.primary_fixed_dim.default.hex_stripped}}'
gradient_color_5 = '#{{colors.secondary_fixed_dim.default.hex_stripped}}'
gradient_color_6 = '#{{colors.tertiary_fixed_dim.default.hex_stripped}}'
