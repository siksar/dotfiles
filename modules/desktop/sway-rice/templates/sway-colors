# noctalia user-template çıktısı → ~/.config/sway/colors (hm.nix'te include edilir)
# Token sözdizimi noctalia v5 Template Reference'a göre: {{ colors.<rol>.default.hex }}
# İlk gerçek duvar kağıdı geçişinde `swaymsg reload` sonrası çıktı dosyasını
# kontrol et — sentaks farklıysa (ör. .default alt-anahtarı yoksa) burada düzelt.
client.focused          #{{ colors.primary.default.hex }} #{{ colors.surface_container.default.hex }} #{{ colors.on_primary.default.hex }} #{{ colors.primary.default.hex }} #{{ colors.primary.default.hex }}
client.focused_inactive #{{ colors.surface_variant.default.hex }} #{{ colors.surface.default.hex }} #{{ colors.on_surface.default.hex }} #{{ colors.surface_variant.default.hex }} #{{ colors.surface_variant.default.hex }}
client.unfocused        #{{ colors.outline_variant.default.hex }} #{{ colors.surface.default.hex }} #{{ colors.on_surface_variant.default.hex }} #{{ colors.outline_variant.default.hex }} #{{ colors.outline_variant.default.hex }}
client.urgent            #{{ colors.error.default.hex }} #{{ colors.error_container.default.hex }} #{{ colors.on_error_container.default.hex }} #{{ colors.error.default.hex }} #{{ colors.error.default.hex }}
